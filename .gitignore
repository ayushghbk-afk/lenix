# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
local.properties
captures/

# Eclipse
.classpath
.project
.settings/

# Keystore and signing material
*.keystore
*.jks
*.p12
*.pem
*.key
signing.properties

# Generated files
bin/
gen/
build/
.externalNativeBuild
.cxx

# Output APK / AAB
*.apk
*.aab
*.ap_
*.dex

# Proguard
proguard/
*.log

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Native build artifacts (source lives under native/ and is tracked)
*.o
*.so
*.a
libs/

# ...but engine payloads under app/src/main/resources/lib/<abi>/ MUST be tracked: they
# ship inside the signed APK (ADR-021), so they are not build artifacts to ignore.
!app/src/main/resources/lib/**/*.so
!app/src/main/resources/lib/**/*.so.*
dist/rootfs/layers/
dist/rootfs/manifests/**.sig
